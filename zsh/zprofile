for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
	if [[ -x "$brew_bin" ]]; then
		eval "$("$brew_bin" shellenv)"
		break
	fi
done

[[ -r "$HOME/.orbstack/shell/init.zsh" ]] && source "$HOME/.orbstack/shell/init.zsh"
[[ -r "$HOME/.swiftly/env.sh" ]] && source "$HOME/.swiftly/env.sh"

if [[ -z "${PNPM_HOME:-}" ]]; then
	if [[ "$OSTYPE" == darwin* ]]; then
		export PNPM_HOME="$HOME/Library/pnpm"
	else
		export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
	fi
fi

# Keep user-level tools, including uv-managed Python, OrbStack's CLI shims,
# and pnpm-managed executables, ahead of package-manager binaries.
typeset -U path PATH
path=("$PNPM_HOME/bin" "$PNPM_HOME" $path)
[[ -d "$HOME/.orbstack/bin" ]] && path=("$HOME/.orbstack/bin" $path)
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)
